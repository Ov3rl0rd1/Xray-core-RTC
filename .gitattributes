# go.sum is an unordered set of module hashes: upstream adds lines for its
# dependency bumps, this fork adds lines for the olcrtc dependencies, and both
# sides land in the same region of the file. A union merge keeps every line from
# both sides, which is exactly the right answer for a hash set -- `go mod tidy`
# afterwards drops whatever is no longer referenced.
go.sum merge=union

# Go sources check out with LF even on Windows (core.autocrlf would otherwise
# hand them over as CRLF). gofumpt rewrites CRLF to LF, so without this every
# file looks unformatted locally while CI, which checks out LF, sees the real
# handful -- and `go run ./infra/vformat/main.go` would rewrite the whole tree.
*.go text eol=lf

# The fork tooling is bash, and it parses fork/*.txt line by line. A CRLF
# checkout (core.autocrlf on Windows) puts a trailing \r inside every path it
# reads, so `fork export` decides that the last file of every patch group is
# unassigned and refuses to run. The patches have to stay LF for the same
# reason: `git apply` against an LF tree would see a whole-file rewrite.
fork/** text eol=lf
