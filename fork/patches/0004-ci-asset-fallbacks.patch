@@ -95,5 +95,26 @@ jobs:
           path: resources
           key: xray-geodat-
           enableCrossOsArchive: true
+      # TestGeodataConfig reads resources/geoip.dat, which only ever arrives via
+      # the cache above. Fetch it directly when the restore comes up empty, from
+      # the same source and with the same digest check scheduled-assets-update.yml
+      # uses.
+      - name: Download Geodat if not restored from cache
