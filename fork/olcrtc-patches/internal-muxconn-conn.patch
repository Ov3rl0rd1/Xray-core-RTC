 // Plaintext buffers are recycled through frameBufPool: Push borrows a
 // buffer to decrypt into, ships it through the channel, and Read returns
 // the buffer to the pool once its caller has consumed all the bytes.
+// Keys protects one record at a time. *crypto.KeySet is the ordinary
+// implementation; taking an interface lets the key itself be negotiated on the
+// wire before the first record flows, instead of having to be shared out of
+// band ahead of time.
+//
+// A Keys that also implements Binder is handed this conn's send function when
+// the conn is built, which is how a negotiating implementation reaches the
+// transport without this package having to know it exists.
+type Keys interface {
+	SealInto(dst, plaintext, aad []byte) ([]byte, error)
+	OpenInto(dst, record, aad []byte) ([]byte, error)
+}
+
+// Binder is implemented by a Keys that needs to send records of its own.
+//
+// aad identifies which plane the send path belongs to — the same value the
+// conn passes to SealInto and OpenInto — so a Keys handed both the data and
+// the control conn can answer on whichever one a record arrived from.
+type Binder interface {
+	Bind(aad []byte, send func([]byte) error, canSend func() bool)
+}
+
+// bindKeys hands the conn's send path to a Keys that asked for it.
+func bindKeys(c *Conn) *Conn {
+	if b, ok := c.keys.(Binder); ok {
+		canSend := c.canSend
+		if canSend == nil {
+			canSend = c.ln.CanSend
+		}
+		b.Bind(c.aad, c.send, canSend)
+	}
+	return c
+}
